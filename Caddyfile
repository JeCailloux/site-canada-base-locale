# Site statique
bastien-site.duckdns.org {
	root * /srv
	file_server
	encode gzip

	# ne pas exposer les fichiers internes (import.html reste accessible pour l'import ponctuel)
	@hidden path /.git* /Caddyfile /docker-compose.yml /README.md /caribou-dump.json
	respond @hidden 404
}

# PocketBase (base locale) — API + admin (/_/)
bastien-db.duckdns.org {
	reverse_proxy pocketbase:8090
}
